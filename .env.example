# Copy to .env.local and fill in. NEVER commit .env.local.
# Neon Postgres (neon.tech > your project > Connect). Pooled string for the app, direct string for db:setup.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

VAANI_API_KEY=
VAANI_API_BASE=https://api.vaanivoice.ai/api
VAANI_WEBHOOK_SECRET=
VAANI_AGENT_ID=

RESEND_API_KEY=
EMAIL_FROM="Aangan Studio <onboarding@resend.dev>"
EMAIL_TEST_MODE=true
TEST_EMAIL=
NIKHIL_EMAIL=
FRONTDESK_EMAIL=
ESCALATION_EMAIL=

# HubSpot service key. Leave empty to switch the HubSpot sync off.
HUBSPOT_ACCESS_TOKEN=

LINK_SIGNING_SECRET=
CRON_SECRET=
DEMO_OPEN=true
APP_BASE_URL=http://localhost:3000
DASHBOARD_PASSCODE=

COST_VAANI_PER_MIN_INR=
COST_GEMINI_INPUT_PER_1M_INR=
COST_GEMINI_OUTPUT_PER_1M_INR=
COST_FIXED_MONTHLY_INR=
